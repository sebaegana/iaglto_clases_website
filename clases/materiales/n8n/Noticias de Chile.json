    {
      "parameters": {
        "jsCode": "function parseRelativeTime(str) {\n  const now = new Date();\n\n  if (!str) return null;\n\n  str = str.toLowerCase();\n\n  if (str.includes(\"hace\")) {\n    const parts = str.split(\" \");\n    const amount = parseInt(parts[1]);\n    const unit = parts[2]; // horas, días, minutos\n\n    if (unit.startsWith(\"hora\")) {\n      now.setHours(now.getHours() - amount);\n    } else if (unit.startsWith(\"día\")) {\n      now.setDate(now.getDate() - amount);\n    } else if (unit.startsWith(\"minuto\")) {\n      now.setMinutes(now.getMinutes() - amount);\n    }\n  }\n\n  return now.toISOString();\n}\n\n// Extraemos arrays\nconst titles = items[0].json[\"Article Titles\"];\nconst links = items[0].json[\"Article Links\"];\nconst sources = items[0].json[\"Article Sources\"];\nconst times = items[0].json[\"Publication Times\"];\n\nreturn titles.map((title, index) => ({\n  json: {\n    title,\n    link: links[index],\n    source: sources[index],\n    time_raw: times[index],                // el texto original\n    time: parseRelativeTime(times[index])  // fecha ISO formateada\n  }\n}));\n\n\n"
      },
